# Copy to .env and adjust. Everything below is free.

# Embeddings: ollama (default, uses GPU) | hf (sentence-transformers) | tfidf (no download, CPU only)
EMBED_BACKEND=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# Answers: ollama (local) | groq (free cloud tier) | none (show retrieved passages only)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# RTX 2060 6GB: qwen2.5:7b. CPU-only laptop: llama3.2:3b or use LLM_PROVIDER=groq
OLLAMA_LLM_MODEL=qwen2.5:7b

# Free key from https://console.groq.com (no card needed)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Retrieval: hybrid | vector | bm25
RETRIEVAL_MODE=hybrid
TOP_K=5
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=150
